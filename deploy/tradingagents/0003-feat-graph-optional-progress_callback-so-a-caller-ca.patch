From f1679c93af44f09e84f5299fc658f13ff12df765 Mon Sep 17 00:00:00 2001
From: Yuanxi Li <liyuanxi23@gmail.com>
Date: Mon, 17 Aug 2026 10:49:09 -0700
Subject: [PATCH 3/4] feat(graph): optional progress_callback so a caller can
 follow a run live

A deep run takes ten minutes or more and returned nothing until it finished, so
any UI in front of it could only show a spinner. The state needed to do better
already existed: the graph streams with stream_mode "values", so every node
boundary yields a complete state snapshot containing whatever reports have been
written so far. It was simply unreachable unless debug=True, which also
pretty-prints the whole transcript to stdout.

TradingAgentsGraph now takes an optional progress_callback. Setting it switches
the run onto the same streaming path debug already used and hands each snapshot
to the callback; debug's printing is now conditional on debug alone, so the two
are independent. The non-debug, no-callback path still uses graph.invoke() and is
untouched.

The callback is wrapped in try/except: progress reporting is strictly less
important than the analysis it describes, so a broken consumer logs and the run
continues.

fix(graph): progress_callback left final_state empty, killing the run at the end

A run with progress_callback set finished its whole debate and then died in
_log_state with KeyError: 'company_of_interest'.

trace.append(chunk) sat inside `if self.debug and chunk["messages"]:`. That was
harmless while debug was the only thing that streamed, but the previous commit
let progress_callback take the streaming path too -- and with debug=False nothing
was ever appended, so the merge produced final_state = {} and every downstream
read of it was a KeyError. The analysis had already been paid for in full by the
time it blew up.

The append is now unconditional, which is what it always meant to be: that list
is the sole source of final_state on the streaming path. Verified with a stub
graph that callback-only, debug-only and both produce the same complete state.

chunk["messages"] is also now chunk.get("messages"), since a chunk without the
key would raise rather than simply skip the pretty-print.
---
 tradingagents/graph/trading_graph.py | 25 ++++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/tradingagents/graph/trading_graph.py b/tradingagents/graph/trading_graph.py
index a190217..176567b 100644
--- a/tradingagents/graph/trading_graph.py
+++ b/tradingagents/graph/trading_graph.py
@@ -71,6 +71,7 @@ class TradingAgentsGraph:
         debug=False,
         config: dict[str, Any] = None,
         callbacks: list | None = None,
+        progress_callback=None,
     ):
         """Initialize the trading agents graph and components.
 
@@ -79,10 +80,15 @@ class TradingAgentsGraph:
             debug: Whether to run in debug mode
             config: Configuration dictionary. If None, uses default config
             callbacks: Optional list of callback handlers (e.g., for tracking LLM/tool stats)
+            progress_callback: Optional callable invoked with each streamed state
+                snapshot as the graph advances, for callers that want to show
+                progress while a run is still going. Setting it switches the run
+                onto the same streaming path ``debug`` uses.
         """
         self.debug = debug
         self.config = config or DEFAULT_CONFIG
         self.callbacks = callbacks or []
+        self.progress_callback = progress_callback
 
         # Update the interface's config
         set_config(self.config)
@@ -437,11 +443,25 @@ class TradingAgentsGraph:
             tid = thread_id(company_name, str(trade_date), self._run_signature(asset_type))
             args.setdefault("config", {}).setdefault("configurable", {})["thread_id"] = tid
 
-        if self.debug:
+        if self.debug or self.progress_callback is not None:
             trace = []
             last_printed = None
             for chunk in self.graph.stream(init_agent_state, **args):
-                if chunk["messages"]:
+                # Unconditionally: this list is what final_state is merged from.
+                # It used to live inside the debug/messages branch, which was
+                # harmless while only debug streamed, but silently produced an
+                # empty final_state once progress_callback could stream too --
+                # the run finished and then died in _log_state with
+                # KeyError: 'company_of_interest'.
+                trace.append(chunk)
+                if self.progress_callback is not None:
+                    # Never let a progress consumer break the run: reporting is
+                    # strictly less important than the analysis it describes.
+                    try:
+                        self.progress_callback(chunk)
+                    except Exception:
+                        logger.warning("progress_callback failed", exc_info=True)
+                if self.debug and chunk.get("messages"):
                     msg = chunk["messages"][-1]
                     # Nodes after the trader don't append to messages, so the
                     # same trailing message repeats across chunks. Print it only
@@ -450,7 +470,6 @@ class TradingAgentsGraph:
                     if signature != last_printed:
                         msg.pretty_print()
                         last_printed = signature
-                    trace.append(chunk)
             # Streamed chunks are per-node deltas. Merge them so the returned
             # state matches what graph.invoke() yields in the non-debug path.
             final_state = {}
